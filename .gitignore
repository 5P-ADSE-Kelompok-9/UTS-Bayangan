# ==========================================
# File Build Maven
# ==========================================
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ==========================================
# File Build Gradle (Jika menggunakan Gradle)
# ==========================================
.gradle
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# ==========================================
# Spring Tool Suite (STS) / Eclipse
# ==========================================
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
bin/
!/.mvn/wrapper/maven-wrapper.jar

# ==========================================
# IntelliJ IDEA
# ==========================================
.idea
*.iws
*.iml
*.ipr
out/

